PORT=5000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=change_this_to_a_strong_random_secret
JWT_EXPIRES_IN=7d

# PostgreSQL (Docker Compose maps 127.0.0.1:15432 -> 5432)
# If PostgreSQL is unavailable, the server falls back to embedded PGlite automatically.
DB_HOST=127.0.0.1
DB_PORT=15432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=edurisk

# Python FastAPI ML Service
ML_SERVICE_URL=http://127.0.0.1:8000

# Email OTP Delivery
# Options:
#   appscript -> HTTPS webhook via Google Apps Script (recommended when SMTP ports are blocked)
#   smtp      -> Direct SMTP (Gmail App Password / Mailtrap / Brevo)
#   demo      -> Console-only OTP logging for local testing
EMAIL_PROVIDER=appscript
APPSCRIPT_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Optional SMTP settings (used when EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="EduRisk Academic Portal <your_email@gmail.com>"
